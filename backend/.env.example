# Copy to backend/.env

# false -> mock forecast + sentiment (no torch/transformers needed)
# true  -> load models from MODELS_DIR. Loading is offline-only (local_files_only),
#          so the service will NEVER download weights at runtime.
ENABLE_LOCAL_MODELS=false

# Relative paths are resolved against the backend/ directory.
MODELS_DIR=models
CHRONOS_MODEL_SUBDIR=chronos-bolt-small
FINBERT_MODEL_SUBDIR=finbert

# Long-term investing defaults
LOOKBACK_PERIOD=5y
FORECAST_HORIZON_WEEKS=26
TORCH_NUM_THREADS=4
