{
  "name": "portfolio-analyzer-desktop",
  "productName": "Portfolio Analyzer",
  "version": "1.0.0",
  "description": "Portfolio Analyzer - long-term portfolio insights and AI-assisted analysis",
  "author": { "name": "Portfolio Analyzer" },
  "private": true,
  "main": "dist-main/main.js",
  "scripts": {
    "start": "electron src/main.js",
    "prepare-main": "node scripts/prepare-main.mjs",
    "dist": "node scripts/prepare-main.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.portfolioanalyzer.desktop",
    "productName": "Portfolio Analyzer",
    "copyright": "Copyright (c) Portfolio Analyzer",
    "directories": { "output": "../dist", "buildResources": "build" },
    "files": ["dist-main/**/*", "package.json", "!**/*.map"],
    "extraResources": [
      { "from": "../build/web", "to": "web", "filter": ["**/*", ".next/**/*", "**/.next/**/*", "**/.prisma/**/*"] },
      { "from": "../build/backend/pa-backend", "to": "backend/pa-backend", "filter": ["**/*"] }
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "PortfolioAnalyzer-Setup-${version}.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Portfolio Analyzer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
