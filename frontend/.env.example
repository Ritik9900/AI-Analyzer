# Copy to frontend/.env

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# FastAPI signals service (server-to-server only; never exposed to the browser)
BACKEND_URL="http://127.0.0.1:8000"

# 32-byte key, base64, used to encrypt the Gemini API key at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=""

# Default Gemini model fallback chain, tried in order (can be overridden in Settings).
# If a model is retired, rate-limited or overloaded, the next one is tried automatically.
GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash"
